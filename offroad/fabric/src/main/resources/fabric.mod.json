{
  "schemaVersion": 1,
  "id": "offroad",
  "version": "${version}",
  "name": "Create Offroad",
  "description": "Adds components to build cars and land vehicles. Fabric port for Minecraft 26.2 + Create Fly.",
  "authors": ["Simulated Team"],
  "contact": {
    "homepage": "https://github.com/Creators-of-Aeronautics/Simulated-Project",
    "sources": "https://github.com/Creators-of-Aeronautics/Simulated-Project",
    "issues": "https://github.com/Creators-of-Aeronautics/Simulated-Project/issues"
  },
  "license": "Read attached LICENSE.md",
  "icon": "offroad.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.ryanhcode.offroad.fabric.OffroadFabric"],
    "client": ["dev.ryanhcode.offroad.fabric.OffroadFabricClient"]
  },
  "mixins": ["offroad.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "create": "*",
    "simulated": "*"
  }
}
